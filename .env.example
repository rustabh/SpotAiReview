# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotaireview"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (openai | anthropic | gemini | mock)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
GEMINI_API_KEY=""

# Email (Resend) — leave blank to fall back to console-logging emails, useful for local dev
RESEND_API_KEY=""
EMAIL_FROM="AiReview <noreply@yourdomain.com>"

# Payments (Razorpay) — leave both blank to demo plan switching without real charges.
# Key IDs are self-describing: rzp_test_... in test mode, rzp_live_... once your Razorpay
# account is KYC-activated for live payments. Get these from Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Razorpay Dashboard > Settings > Webhooks, when adding the /api/webhooks/razorpay endpoint.
RAZORPAY_WEBHOOK_SECRET=""

# Protects the /api/cron/generate-blog endpoint from being triggered by anyone but Vercel Cron.
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
