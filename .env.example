# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotaireview"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (openai | anthropic | gemini | mock)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
GEMINI_API_KEY=""

# Email (Resend) — leave blank to fall back to console-logging emails, useful for local dev
RESEND_API_KEY=""
EMAIL_FROM="AiReview <noreply@yourdomain.com>"

# Payments (Razorpay) — leave both blank to demo plan switching without real charges.
# Key IDs are self-describing: rzp_test_... in test mode, rzp_live_... once your Razorpay
# account is KYC-activated for live payments. Get these from Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Razorpay Dashboard > Settings > Webhooks, when adding the /api/webhooks/razorpay endpoint.
RAZORPAY_WEBHOOK_SECRET=""

# Protects the /api/cron/generate-blog endpoint from being triggered by anyone but Vercel Cron.
CRON_SECRET=""

# Febble Spot — POS integrations (Spot Order). Encrypts POSCredential.encryptedPayload
# at rest (AES-256-GCM); required once a business connects a real POS provider, unused
# while every business is still on the built-in MockPOSProvider.
# Generate with: openssl rand -base64 32
POS_CREDENTIAL_ENCRYPTION_KEY=""

# Google Business Profile — AI auto-reply to Google reviews (Spot AI Review). Requires a Google
# Cloud project with the Business Profile API enabled, an OAuth 2.0 client (redirect URI:
# {NEXT_PUBLIC_APP_URL}/api/google-business/callback, scope: business.manage), AND Google's
# approval of a Business Profile API access request — that approval happens on Google's side and
# cannot be skipped by configuring anything here. Leave blank and the feature shows "not
# configured" instead of breaking.
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Social auto-posting — AI-drafted Facebook & Instagram posts from the menu. Requires a Meta
# developer app (developers.facebook.com) with Facebook Login and the Instagram Graph API
# products added, an OAuth redirect URI of {NEXT_PUBLIC_APP_URL}/api/social/callback, AND
# Meta's App Review approval of the pages_manage_posts and instagram_content_publish
# permissions — that approval happens on Meta's side and cannot be skipped by configuring
# anything here. Leave blank and the feature shows "not configured" instead of breaking.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
