// Spot AI Review — database schema
// Every model uses a UUID primary key; no sequential IDs are ever exposed publicly.
// Public-facing identifiers (campaign slugs/codes) are separate, non-sequential fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReviewTone {
  NATURAL
  PROFESSIONAL
  FRIENDLY
  CASUAL
  DETAILED
}

enum ReviewLength {
  SHORT
  MEDIUM
  DETAILED
}

enum DraftVariant {
  NATURAL
  SHORT
  DETAILED
  REGENERATED
  CUSTOM
}

enum PrivateFeedbackStatus {
  NEW
  READ
  RESOLVED
}

enum AnalyticsEventType {
  SCAN
  SESSION_STARTED
  LANGUAGE_SELECTED
  RATING_GIVEN
  ATTRIBUTES_SELECTED
  FEEDBACK_SUBMITTED
  AI_DRAFT_GENERATED
  DRAFT_TRANSFORMED
  DRAFT_COPIED
  GOOGLE_CLICK
  PRIVATE_FEEDBACK_SUBMITTED
  MENU_VIEWED
  PRODUCT_VIEWED
  CART_ITEM_ADDED
  ORDER_PLACED
}

// ---------------------------------------------------------------------------
// Febble Spot — Menu / Ordering / Tables / POS (additive; Spot AI Review's
// existing models and flows above are untouched by everything below)
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderPOSSyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum TableSessionPaymentMethod {
  ONLINE
  COUNTER
}

// A quick, tag-based reaction instead of a star rating — collected right at
// the bill, both for the table's overall visit and for each item ordered.
enum RatingSentiment {
  MOST_RECOMMENDED
  WOULD_RECOMMEND
  OKAY
  COULD_BE_BETTER
}

enum POSProviderName {
  MOCK
  PETPOOJA
}

enum POSConnectionStatus {
  CONNECTED
  DISCONNECTED
  AUTH_ERROR
  SYNC_ERROR
}

enum POSSyncType {
  MENU
  ORDER
}

enum POSSyncResult {
  SUCCESS
  FAILURE
}

enum GoogleConnectionStatus {
  CONNECTED
  PENDING_LOCATION // tokens exchanged, owner still needs to pick which Google location this business is
  DISCONNECTED
  AUTH_ERROR // refresh token revoked/expired — needs to reconnect
}

enum GoogleReplyStatus {
  NONE // no reply yet
  DRAFTED // AI wrote a reply, waiting on the owner to approve/edit/post it
  POSTED // reply is live on Google
  FAILED // last post attempt to Google failed
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MANUAL
}

enum AIPurpose {
  GENERATE_DRAFTS
  TRANSFORM_DRAFT
  INSIGHTS
}

enum AIProviderName {
  OPENAI
  ANTHROPIC
  GEMINI
  MOCK
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  image         String?
  phone         String?

  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  businessMemberships       BusinessMember[]
  subscriptions             Subscription[]
  notifications             Notification[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  createdCategories         BusinessCategory[]         @relation("CategoryCreator")
  createdBusinesses         Business[]                 @relation("BusinessCreator")
  sentTeamInvites           TeamInvite[]
  connectedGoogleBusinesses GoogleBusinessConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Short-lived, single-use token that powers the audited "Login as Owner"
// super-admin feature. Never a substitute for the owner's real credentials.
model ImpersonationToken {
  id           String    @id @default(uuid())
  token        String    @unique
  targetUserId String
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// A BusinessMember row links a User to a Business with a role, so a single
// business owner (User) can own/manage many businesses, and a business can
// have a small team (owner/manager/staff) with different permissions.
model BusinessMember {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        BusinessMemberRole @default(STAFF)
  permissions Json?
  invitedAt   DateTime           @default(now())
  acceptedAt  DateTime?

  @@unique([userId, businessId])
  @@index([businessId])
}

// A pending invite for someone who doesn't have an AiReview account yet.
// Once they accept (creating an account in the process), this becomes a
// BusinessMember row and the invite is marked accepted.
model TeamInvite {
  id          String             @id @default(uuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        BusinessMemberRole @default(STAFF)
  token       String             @unique
  invitedById String
  invitedBy   User               @relation(fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime           @default(now())

  @@index([businessId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Business Category System (dynamic, admin-configurable, not restaurant-only)
// ---------------------------------------------------------------------------

model BusinessCategory {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  description     String?
  aiContext       String? // extra context fed to the AI for this category
  terminology     Json? // recommended terminology / synonyms for this category
  // Default Febble Spot module flags for businesses in this category — e.g.
  // {"menu":true,"ordering":true,"tables":true,"pos":false,"services":false,
  // "products":false,"appointments":false,"reviews":true,"digitalCard":true}.
  // Read only via getEffectiveFeatures() in src/lib/features.ts.
  defaultFeatures Json    @default("{}")
  isCustom        Boolean @default(false)
  isActive        Boolean @default(true)
  createdById     String?
  createdBy       User?   @relation("CategoryCreator", fields: [createdById], references: [id])

  attributes CategoryAttribute[]
  questions  CategoryQuestion[]
  businesses Business[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The selectable "experience" chips shown to customers (e.g. Service, Staff, Cleanliness)
model CategoryAttribute {
  id         String           @id @default(uuid())
  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  order      Int              @default(0)
  isActive   Boolean          @default(true)

  @@index([categoryId])
}

// Configurable follow-up questions asked during the feedback flow
model CategoryQuestion {
  id         String           @id @default(uuid())
  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text       String
  isRequired Boolean          @default(false)
  order      Int              @default(0)

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Business
// ---------------------------------------------------------------------------

model Business {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  categoryId    String
  category      BusinessCategory @relation(fields: [categoryId], references: [id])
  subcategory   String?
  description   String?
  logoUrl       String?
  coverImageUrl String?

  phone    String?
  email    String?
  website  String?
  whatsapp String?
  address  String?
  city     String?
  state    String?
  country  String?

  instagramUrl String?
  facebookUrl  String?
  linkedinUrl  String?
  youtubeUrl   String?

  usp            String?
  targetAudience String?
  brandTone      String?

  primaryColor   String @default("#0F172A")
  secondaryColor String @default("#F8FAFC")
  buttonColor    String @default("#2563EB")

  defaultLanguage  String       @default("en")
  allowedLanguages Json         @default("[\"en\"]")
  aiTone           ReviewTone   @default(NATURAL)
  aiLength         ReviewLength @default(MEDIUM)

  status BusinessStatus @default(ACTIVE)

  // Per-business overrides on top of category.defaultFeatures — same shape,
  // any key present here wins. Read only via getEffectiveFeatures().
  featureOverrides Json?

  createdById String
  createdBy   User   @relation("BusinessCreator", fields: [createdById], references: [id])

  members            BusinessMember[]
  teamInvites        TeamInvite[]
  services           BusinessService[]
  campaigns          ReviewCampaign[]
  feedback           CustomerFeedback[]
  privateFeedback    PrivateFeedback[]
  analyticsEvents    AnalyticsEvent[]
  aiUsage            AIUsage[]
  googleReviewConfig GoogleReviewConfiguration?
  customerSessions   CustomerSession[]
  notifications      Notification[]

  productCategories        ProductCategory[]
  products                 Product[]
  tables                   RestaurantTable[]
  tableSessions            TableSession[]
  orders                   Order[]
  posIntegration           POSIntegration?
  googleBusinessConnection GoogleBusinessConnection?
  googleReviews            GoogleReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model BusinessService {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([businessId])
}

model GoogleReviewConfiguration {
  id              String    @id @default(uuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleReviewUrl String
  googlePlaceId   String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// QR / NFC Campaigns
// ---------------------------------------------------------------------------

// A ReviewCampaign is the single addressable unit behind a printed QR code,
// an NFC tap, or a digital link — they all resolve to the same /r/[slug] URL.
model ReviewCampaign {
  id                      String         @id @default(uuid())
  businessId              String
  business                Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                    String
  code                    String         @unique // e.g. SPOT-RVW-8H3K92
  slug                    String         @unique // public URL segment: /r/[slug]
  placement               String? // e.g. "Reception", "Table 3", "Billing Counter"
  description             String?
  ctaText                 String         @default("Scan to Share Your Experience")
  googleReviewUrlOverride String?
  status                  CampaignStatus @default(ACTIVE)

  qrCode          QRCode?
  nfcDevices      NFCDevice[]
  sessions        CustomerSession[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model QRCode {
  id              String         @id @default(uuid())
  campaignId      String         @unique
  campaign        ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  style           String         @default("standard") // standard | branded | logo
  foregroundColor String         @default("#0F172A")
  backgroundColor String         @default("#FFFFFF")
  includeLogo     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model NFCDevice {
  id         String         @id @default(uuid())
  campaignId String
  campaign   ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label      String // e.g. "NFC Standee - Entrance"
  uid        String         @unique // physical tag identifier
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Customer flow (anonymous — no login required)
// ---------------------------------------------------------------------------

model CustomerSession {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  language      String?
  deviceType    String?
  userAgentHash String?
  currentStep   String         @default("landing")
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  feedback        CustomerFeedback?
  privateFeedback PrivateFeedback?
  drafts          AIReviewDraft[]
  analyticsEvents AnalyticsEvent[]
  aiUsage         AIUsage[]

  @@index([businessId])
  @@index([campaignId])
}

model CustomerFeedback {
  id                 String          @id @default(uuid())
  sessionId          String          @unique
  session            CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating             Int
  selectedAttributes Json            @default("[]")
  writtenFeedback    String?
  language           String          @default("en")
  createdAt          DateTime        @default(now())

  @@index([businessId])
  @@index([rating])
}

model AIReviewDraft {
  id        String          @id @default(uuid())
  sessionId String
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variant   DraftVariant
  content   String
  tone      ReviewTone
  length    ReviewLength
  provider  AIProviderName
  model     String
  isFinal   Boolean         @default(false)
  isCopied  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

model PrivateFeedback {
  id          String                @id @default(uuid())
  sessionId   String                @unique
  session     CustomerSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  message     String
  contactInfo String?
  status      PrivateFeedbackStatus @default(NEW)
  createdAt   DateTime              @default(now())

  @@index([businessId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id         String             @id @default(uuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   ReviewCampaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    CustomerSession?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       AnalyticsEventType
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([businessId, type, createdAt])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Subscriptions & Billing (architecture-ready; payment provider pluggable)
// ---------------------------------------------------------------------------

model Plan {
  id                     String  @id @default(uuid())
  name                   String  @unique
  slug                   String  @unique
  monthlyPrice           Int     @default(0) // stored in smallest currency unit
  yearlyPrice            Int     @default(0)
  currency               String  @default("INR")
  businessLimit          Int     @default(1)
  campaignLimit          Int     @default(3)
  aiGenerationsPerMonth  Int     @default(100)
  analyticsRetentionDays Int     @default(30)
  teamMemberLimit        Int     @default(1)
  languageLimit          Int     @default(2)
  advancedInsights       Boolean @default(false)
  isActive               Boolean @default(true)

  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Payment {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?           @relation(fields: [planId], references: [id])
  amount         Int
  currency       String          @default("INR")
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider @default(MANUAL)
  providerRef    String?
  createdAt      DateTime        @default(now())

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// AI usage / cost tracking
// ---------------------------------------------------------------------------

model AIUsage {
  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          CustomerSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  purpose          AIPurpose
  provider         AIProviderName
  model            String
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float            @default(0)
  createdAt        DateTime         @default(now())

  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications & Audit
// ---------------------------------------------------------------------------

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  isRead     Boolean   @default(false)
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Platform-wide configuration (Super Admin)
// ---------------------------------------------------------------------------

model Language {
  id        String  @id @default(uuid())
  code      String  @unique // e.g. "en", "hi", "hi-en" (Hinglish)
  name      String
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
}

model PlatformSettings {
  id                         String         @id @default(uuid())
  platformName               String         @default("Spot AI Review")
  logoUrl                    String?
  primaryColor               String         @default("#2563EB")
  aiProvider                 AIProviderName @default(MOCK)
  aiModel                    String         @default("gpt-4o-mini")
  defaultSystemPrompt        String         @default("Write a natural review based ONLY on the customer's stated experience. Do not invent facts. Do not add claims the customer did not provide. Preserve the customer's meaning. Avoid exaggerated marketing language. The review should sound like a real person wrote it.")
  maxAIGenerationsPerSession Int            @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Blog (SEO content, auto-generated daily via the AI provider)
// ---------------------------------------------------------------------------

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  excerpt         String
  content         String         @db.Text // Markdown
  coverEmoji      String         @default("✨")
  category        String         @default("Guides")
  keywords        Json           @default("[]")
  metaTitle       String
  metaDescription String
  readingMinutes  Int            @default(8)
  status          BlogPostStatus @default(PUBLISHED)
  generatedBy     String         @default("mock") // AI provider name that wrote it
  publishedAt     DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// Febble Spot — Digital Menu / Products
// ---------------------------------------------------------------------------

model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  isActive   Boolean  @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Product {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  imageUrl      String?
  price         Int // smallest currency unit, same convention as Plan/Payment
  discountPrice Int?
  isVeg         Boolean? // null = not applicable to this business type
  spiceLevel    String?
  tags          Json             @default("[]")
  isAvailable   Boolean          @default(true)
  order         Int              @default(0)
  posExternalId String? // item ID in the connected POS, once synced

  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([categoryId])
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "Half", "Full"
  priceDelta    Int     @default(0)
  isDefault     Boolean @default(false)
  posExternalId String?
  order         Int     @default(0)

  orderItems OrderItem[]

  @@index([productId])
}

model ProductModifierGroup {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // e.g. "Add-ons", "Spice Level"
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  isRequired Boolean @default(false)
  order      Int     @default(0)

  options ProductModifierOption[]

  @@index([productId])
}

model ProductModifierOption {
  id            String               @id @default(uuid())
  groupId       String
  group         ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  priceDelta    Int                  @default(0)
  posExternalId String?
  order         Int                  @default(0)

  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Febble Spot — Tables & Table Sessions
// ---------------------------------------------------------------------------

model RestaurantTable {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number     String // display label — "12", "A1" — not necessarily numeric
  section    String?
  capacity   Int?
  status     TableStatus @default(AVAILABLE)
  qrToken    String      @unique // opaque token behind /order/[qrToken]
  isActive   Boolean     @default(true)

  sessions TableSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, number])
  @@index([businessId])
}

model TableSession {
  id         String             @id @default(uuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableId    String
  table      RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  code       String             @unique // e.g. TS-2026-00124
  status     TableSessionStatus @default(OPEN)
  openedAt   DateTime           @default(now())
  closedAt   DateTime?

  // The bill/payment lifecycle that closes a session: requested -> a method is chosen ->
  // paidAt set (immediately for online, once staff confirms for counter) -> session closes,
  // freeing the table for the next guest's scan to start a brand new session.
  billRequestedAt DateTime?
  paymentMethod   TableSessionPaymentMethod?
  razorpayOrderId String?
  paidAt          DateTime?

  // Collected alongside the bill — optional, never blocks payment.
  overallRating     RatingSentiment?
  ratingSubmittedAt DateTime?

  orders Order[]

  @@index([businessId])
  @@index([tableId])
}

// ---------------------------------------------------------------------------
// Febble Spot — Orders (Spot Order)
// ---------------------------------------------------------------------------

model Order {
  id                  String             @id @default(uuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableSessionId      String?
  tableSession        TableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  code                String             @unique // e.g. SP1024, shown to the customer
  type                OrderType
  status              OrderStatus        @default(RECEIVED)
  customerName        String?
  customerPhone       String?
  deliveryAddress     Json?
  specialInstructions String?
  subtotal            Int
  taxAmount           Int                @default(0)
  chargesAmount       Int                @default(0)
  totalAmount         Int
  currency            String             @default("INR")
  // Prevents duplicate orders from a double-tap "Place Order" or a retried
  // request — the create path is a no-op (returns the existing order) on a
  // second call with the same key. See docs/febble-spot-architecture.md §9.
  idempotencyKey      String             @unique
  posOrderId          String?
  posSyncStatus       OrderPOSSyncStatus @default(NOT_SYNCED)
  posSyncError        String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([tableSessionId])
}

model OrderItem {
  id                  String           @id @default(uuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String // snapshot at order time — survives menu edits/deletes
  variantId           String?
  variant             ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName         String?
  quantity            Int              @default(1)
  unitPrice           Int
  lineTotal           Int
  specialInstructions String?
  rating              RatingSentiment? // the customer's quick reaction to this item, given at the bill

  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id               String                 @id @default(uuid())
  orderItemId      String
  orderItem        OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId String?
  modifierOption   ProductModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
  name             String // snapshot
  priceDelta       Int                    @default(0)

  @@index([orderItemId])
}

// ---------------------------------------------------------------------------
// Febble Spot — POS Connector
// ---------------------------------------------------------------------------

model POSIntegration {
  id              String              @id @default(uuid())
  businessId      String              @unique
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider        POSProviderName
  status          POSConnectionStatus @default(DISCONNECTED)
  lastMenuSyncAt  DateTime?
  lastOrderSyncAt DateTime?
  lastError       String?

  credential POSCredential?
  syncLogs   POSSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Never read outside src/lib/pos/** — every dashboard/action surface gets
// POSIntegration's status/timestamps only, never this row.
model POSCredential {
  id               String         @id @default(uuid())
  posIntegrationId String         @unique
  posIntegration   POSIntegration @relation(fields: [posIntegrationId], references: [id], onDelete: Cascade)
  encryptedPayload String // AES-256-GCM ciphertext; see src/lib/pos/crypto.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model POSSyncLog {
  id               String         @id @default(uuid())
  posIntegrationId String
  posIntegration   POSIntegration @relation(fields: [posIntegrationId], references: [id], onDelete: Cascade)
  type             POSSyncType
  result           POSSyncResult
  message          String?
  createdAt        DateTime       @default(now())

  @@index([posIntegrationId, createdAt])
}

// ---------------------------------------------------------------------------
// Google Business Profile — AI auto-reply to Google reviews
// ---------------------------------------------------------------------------

model GoogleBusinessConnection {
  id                 String                 @id @default(uuid())
  businessId         String                 @unique
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status             GoogleConnectionStatus @default(PENDING_LOCATION)
  googleAccountName  String? // e.g. "accounts/106..." — set once, never changes after connect
  googleLocationName String? // e.g. "accounts/106.../locations/456..." — chosen by the owner if there's more than one
  locationTitle      String? // human-readable name from Google, shown in the dashboard
  autoReplyEnabled   Boolean                @default(false) // false = AI drafts a reply and the owner approves it before it posts

  lastSyncAt DateTime?
  lastError  String?

  // Cached result of the last ranking audit (src/actions/gmb-audit.ts) — recomputed on demand
  // rather than kept in a history table, since only "where do we stand right now" matters here.
  lastAuditAt        DateTime?
  lastAuditScore     Int? // 0-100
  lastAuditChecklist Json? // GmbAuditCheck[] — see src/lib/google/audit.ts
  lastAuditSummary   String? // AI-written prioritized action plan

  connectedById String
  connectedBy   User   @relation(fields: [connectedById], references: [id])

  credential GoogleBusinessCredential?
  reviews    GoogleReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Never read outside src/lib/google/** — every dashboard/action surface gets
// GoogleBusinessConnection's status/settings only, never this row. Same
// pattern as POSCredential.
model GoogleBusinessCredential {
  id                         String                   @id @default(uuid())
  googleBusinessConnectionId String                   @unique
  googleBusinessConnection   GoogleBusinessConnection @relation(fields: [googleBusinessConnectionId], references: [id], onDelete: Cascade)
  encryptedPayload           String // AES-256-GCM ciphertext of {accessToken, refreshToken, expiresAt}; see src/lib/google/crypto.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleReview {
  id                         String                   @id @default(uuid())
  businessId                 String
  business                   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleBusinessConnectionId String
  googleBusinessConnection   GoogleBusinessConnection @relation(fields: [googleBusinessConnectionId], references: [id], onDelete: Cascade)

  googleReviewName String   @unique // Google's full review resource name — the stable external id
  reviewerName     String
  reviewerPhotoUrl String?
  starRating       Int // 1-5
  comment          String?
  reviewCreatedAt  DateTime
  reviewUpdatedAt  DateTime

  replyStatus GoogleReplyStatus @default(NONE)
  draftReply  String? // AI-generated, editable, awaiting owner approval
  postedReply String? // what actually went live on Google
  repliedAt   DateTime?
  replyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, replyStatus])
}
